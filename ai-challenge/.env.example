# Copy to .env and fill in. .env is git-ignored.
GEMINI_API_KEY=
# Optional
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=low
# MEDEXTRACT_NO_CACHE=1
# GEMINI_TIMEOUT_S=90       # per network operation (connect, upload chunk, waiting for bytes)
# GEMINI_DEADLINE_S=120     # hard limit per attempt; a healthy call takes ~12s
# GEMINI_MAX_RETRIES=4      # network errors 2/4/8/16s backoff; overload (429/503) 15/30/60s
