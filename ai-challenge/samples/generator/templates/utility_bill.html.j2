{# Non-medical negative sample: an electricity bill. It has a name, a date, an amount and a
   payment method, so it can tempt a model into filling receipt fields. Everything lives in
   doc.extra because none of it belongs in the medical schemas. #}
{% extends "base.html.j2" %}
{% set x = doc.extra %}
{% block style %}
  .due { margin-top: 12px; display: flex; gap: 12px; }
  .due > div { flex: 1; background: #f1f5ee; border: 1px solid #c9d8bf; padding: 10px; }
  .due .big { font-size: 16pt; font-weight: 800; }
  .bar { height: 14px; background: var(--accent); display: inline-block; vertical-align: middle; }
{% endblock %}
{% block body %}
<header class="hdr">
  <div class="logo">{{ x.logo_initials }}</div>
  <div class="org">
    <div class="org-name">{{ x.company }}</div>
    <div class="muted">{{ x.address }}</div>
    <div class="muted">Call centre {{ x.phone }}</div>
  </div>
  <div class="doc-title">ELECTRICITY<br>BILL</div>
</header>

<table class="meta">
  <tr><th>Customer</th><td><b>{{ x.customer }}</b></td><th>Account no.</th><td>{{ x.account_no }}</td></tr>
  <tr><th>Service address</th><td>{{ x.service_address }}</td><th>Bill date</th><td>{{ x.bill_date }}</td></tr>
  <tr><th>Meter no.</th><td>{{ x.meter_no }}</td><th>Billing period</th><td>{{ x.period }}</td></tr>
</table>

<div class="due">
  <div><div class="muted">Amount due</div><div class="big">{{ x.amount_due }}</div></div>
  <div><div class="muted">Due date</div><div class="big">{{ x.due_date }}</div></div>
  <div><div class="muted">Payment method</div><div class="big" style="font-size:12pt">{{ x.payment_method }}</div></div>
</div>

<div class="section">
  <h3>Charges</h3>
  <table class="grid">
    <thead><tr><th>Item</th><th class="num">Units</th><th class="num">Rate</th><th class="num">Amount (THB)</th></tr></thead>
    <tbody>{% for c in x.charges %}
      <tr><td>{{ c[0] }}</td><td class="num">{{ c[1] }}</td><td class="num">{{ c[2] }}</td><td class="num">{{ c[3] }}</td></tr>
    {% endfor %}</tbody>
  </table>
</div>

<div class="section">
  <h3>Usage history (kWh)</h3>
  <table class="meta">{% for m in x.history %}
    <tr><th>{{ m[0] }}</th><td><span class="bar" style="width: {{ m[1] // 2 }}px"></span> {{ m[1] }}</td></tr>
  {% endfor %}</table>
</div>
<div class="footer muted">{{ x.footer }}</div>
{% endblock %}
