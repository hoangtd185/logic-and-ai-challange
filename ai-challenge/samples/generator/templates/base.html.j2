<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>{{ spec.id }}</title>
<style>
  /* A4. PDFs use @page margins; PNG "scans" have no pages, so .page pads instead. */
  @page { size: A4; margin: 14mm 14mm 16mm; }
  :root { --accent: {{ doc.extra.accent }}; --ink: #1c2229; --muted: #5d6874; --rule: #c9d0d8; }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: #fff; }
  body {
    font-family: "Segoe UI", "DejaVu Sans", "Noto Sans", Arial, sans-serif;
    font-size: 10.5pt; line-height: 1.4; color: var(--ink);
  }
  body.scan { width: 210mm; }
  body.scan .page { padding: 14mm; }
  h1, h2, h3 { margin: 0; }
  .muted { color: var(--muted); font-size: 9pt; }
  .hdr { display: flex; align-items: center; gap: 12px; padding-bottom: 10px; border-bottom: 3px solid var(--accent); }
  .logo {
    width: 52px; height: 52px; border-radius: 50%; background: var(--accent); color: #fff;
    display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16pt; flex: none;
  }
  .org { flex: 1; }
  .org-name { font-size: 15pt; font-weight: 700; }
  .doc-title { font-size: 17pt; font-weight: 800; letter-spacing: .06em; color: var(--accent); text-align: right; }
  .doc-title.center { text-align: center; margin: 14px 0 6px; }
  table { width: 100%; border-collapse: collapse; }
  table.meta { margin: 12px 0; }
  table.meta th { text-align: left; color: var(--muted); font-weight: 600; width: 18%; padding: 3px 6px 3px 0; vertical-align: top; }
  table.meta td { padding: 3px 12px 3px 0; vertical-align: top; }
  table.grid th { background: #eef1f4; text-align: left; font-size: 9pt; padding: 6px; border-bottom: 1.5px solid var(--ink); }
  table.grid td { padding: 6px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .num { text-align: right; white-space: nowrap; }
  .section { margin-top: 14px; }
  .section h3 {
    font-size: 10pt; text-transform: uppercase; letter-spacing: .05em; color: var(--accent);
    border-bottom: 1px solid var(--rule); padding-bottom: 3px; margin-bottom: 6px;
  }
  .section p { margin: 4px 0; }
  ul { margin: 4px 0; padding-left: 18px; }
  .sign { margin-top: 28px; display: flex; justify-content: flex-end; }
  .sign-box { width: 46%; text-align: center; }
  .sign-line { border-bottom: 1px dotted var(--ink); height: 34px; margin: 4px 0; }
  .footer { margin-top: 22px; border-top: 1px solid var(--rule); padding-top: 6px; }
  .page-break { break-before: page; }
  {% block style %}{% endblock %}
</style>
</head>
<body class="{{ 'scan' if scan else 'print' }}">
<div class="page">
{% block body %}{% endblock %}
</div>
</body>
</html>
